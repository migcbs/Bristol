generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  TEACHER
  STUDENT
  PARENT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AnnouncementAudience {
  ALL
  CAMPUS
  ROLE
}

enum StaffPosition {
  RECEPCION
  CAJA
  CONTROL_ESCOLAR
  COMERCIAL
  CALIDAD_CONTROL
  DIRECCION_CAMPUS
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff                 StaffCampus[]
  teachers              TeacherCampus[]
  students              Student[]
  groups                Group[]
  leads                 Lead[]
  announcements         Announcement[]
  placementAppointments PlacementAppointment[]
  receptionLogEntries   ReceptionLogEntry[]
  recursosMateriales    RecursoMaterial[]
  cashMovements         CashMovement[]
  cashRegisterSessions  CashRegisterSession[]
  staffCalendarEvents   StaffCalendarEvent[]
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  name               String
  role               Role
  emailVerifiedAt    DateTime?
  staffPosition      StaffPosition?
  // Set when Recepción creates an account with a system-generated temporary
  // password. Cleared the moment the user sets their own password. The
  // portal layout enforces this — see src/app/portal/layout.tsx.
  mustChangePassword Boolean        @default(false)
  // One-off Module grants an ADMIN hands a specific STAFF account regardless
  // of their puesto — e.g. letting one Recepción account see Reseñas
  // without giving that to all of Recepción. Stored as raw strings (Module
  // is a TS-level union in src/lib/staff-permissions.ts, not a DB enum) and
  // validated against that union at the API boundary. See hasModuleAccess().
  extraModuleAccess  String[]       @default([])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Fiscal data for CFDI — populated for a PARENT who's the actual payer
  // (the common case) or for an adult STUDENT paying for themselves.
  // Mirrors the same 5 fields already on Student, kept separate rather
  // than merged: a PARENT has no Student row to hang these off of.
  rfc                String?
  razonSocial        String?
  regimenFiscal      String?
  codigoPostalFiscal String?
  usoCfdi            String?

  staffCampuses        StaffCampus[]
  teacherCampuses      TeacherCampus[]
  student              Student?
  parentLinks          ParentStudent[]
  tokens               VerificationToken[]
  teachingGroups       Group[]             @relation("GroupTeacher")
  reportedIncidents    Incident[]
  createdAnnouncements Announcement[]
  uploadedMaterials    Material[]
  createdGrades        Grade[]
  leadsAsAdvisor       Lead[]              @relation("LeadAdvisor")
  receptionLogEntries  ReceptionLogEntry[]

  createdBlockEvaluations BlockEvaluation[]
  requestedGroupChanges   GroupChangeRequest[] @relation("RequestedBy")
  reviewedGroupChanges    GroupChangeRequest[] @relation("ReviewedBy")
  createdTickets          InterAreaTicket[]    @relation("TicketCreatedBy")
  assignedTickets         InterAreaTicket[]    @relation("TicketAssignedTo")
  notifications           Notification[]
  reviewedTestimonials    Testimonial[]        @relation("TestimonialReviewedBy")
  cashMovements           CashMovement[]

  createdMaterialCarpetas  MaterialCarpeta[]
  uploadedLibraryItems     MaterialLibraryItem[]
  materialAccessRequests   MaterialAccessRequest[] @relation("MaterialAccessRequestTeacher")
  reviewedMaterialRequests MaterialAccessRequest[] @relation("MaterialAccessRequestReviewer")

  alumniOutreachLogs AlumniOutreachLog[]
  uploadedStudentDocuments StudentDocument[]
  openedCashSessions CashRegisterSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashRegisterSession[] @relation("CashSessionClosedBy")
  resolvedIncidents  Incident[]            @relation("IncidentResolvedBy")
  staffCalendarEvents StaffCalendarEvent[]
}

model StaffCampus {
  id       String @id @default(cuid())
  userId   String
  campusId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([userId, campusId])
}

model TeacherCampus {
  id       String @id @default(cuid())
  userId   String
  campusId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus   Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([userId, campusId])
}

enum StudentStatus {
  ACTIVO
  BAJA
  GRADUADO
}

enum Sexo {
  MASCULINO
  FEMENINO
}

model Student {
  id                         String        @id @default(cuid())
  userId                     String        @unique
  campusId                   String
  createdAt                  DateTime      @default(now())
  matricula                  String        @unique
  curp                       String?
  fechaNacimiento            DateTime?
  sexo                       Sexo?
  entregaActa                Boolean       @default(false)
  entregaCurp                Boolean       @default(false)
  entregaComprobante         Boolean       @default(false)
  telefonoFijo               String?
  telefonoMovil              String?
  emailContacto              String?
  domicilioCalle             String?
  domicilioNumero            String?
  domicilioColonia           String?
  domicilioCP                String?
  domicilioCiudad            String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  rfc                        String?
  razonSocial                String?
  regimenFiscal              String?
  codigoPostalFiscal         String?
  usoCfdi                    String?
  estatusAlumno              StudentStatus @default(ACTIVO)
  // Comercial's reengagement flag for a BAJA/GRADUADO student — null means
  // "not yet assessed", set from an AlumniOutreachLog entry. Confirmed with
  // the user 2026-09-09: reuse Student rather than a separate ex-alumni
  // model, since all their personal data already lives here.
  interesadoEnVolver         Boolean?
  user                       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus                     Campus        @relation(fields: [campusId], references: [id])

  parentLinks ParentStudent[]
  enrollments Enrollment[]
  invoices    Invoice[]
  incidents   Incident[]

  groupChangeRequests GroupChangeRequest[]
  alumniOutreachLogs  AlumniOutreachLog[]
  documents           StudentDocument[]
}

enum StudentDocumentType {
  ACTA
  CURP
  COMPROBANTE
}

// Real file behind the entregaActa/entregaCurp/entregaComprobante flags —
// confirmed with the user 2026-09-09: those were just checkboxes with no
// document behind them ("son solo como etiquetas que no hacen nada").
// One document per type per student; a re-upload replaces it (see the
// upload route, which does an upsert). `storageKey` is a path understood
// by src/lib/student-document-storage.ts — see that file for the current
// local-disk implementation and its production caveat.
model StudentDocument {
  id           String              @id @default(cuid())
  studentId    String
  tipo         StudentDocumentType
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime            @default(now())

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([studentId, tipo])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

model Invoice {
  id                        String        @id @default(cuid())
  studentId                 String
  description               String
  amountCents               Int
  dueDate                   DateTime
  status                    InvoiceStatus @default(PENDING)
  stripeCheckoutSessionId   String?
  paidAt                    DateTime?
  createdAt                 DateTime      @default(now())
  baseCents                 Int?
  scholarshipPercent        Decimal?      @db.Decimal(5, 2)
  earlyPaymentDiscountCents Int?
  // Nullable during rollout — existing invoices predate the catalog and
  // keep using the free-text `description` alone.
  conceptoPagoId            String?
  // Not a real SAT-stamped CFDI (no PAC integration — same scope decision
  // as the rest of this project's fiscal fields). This just tracks whether
  // Caja emailed the payer a receipt that includes their captured fiscal
  // data, so it isn't sent twice by accident.
  reciboFiscalEnviado       Boolean       @default(false)
  reciboFiscalEnviadoAt     DateTime?

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conceptoPago  ConceptoPago?  @relation(fields: [conceptoPagoId], references: [id])
  cashMovements CashMovement[]
}

// Reusable catalog of billable concepts (Inscripción, Colegiatura, Examen,
// Material...) so Caja picks from a consistent list instead of retyping a
// free-text description every time. `montoDefaultCents` is just a
// starting point Caja can override per invoice — not an enforced price.
model ConceptoPago {
  id                String   @id @default(cuid())
  nombre            String   @unique
  montoDefaultCents Int?
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())

  invoices Invoice[]
}

// Physical school inventory Caja sells or tracks — books, exam booklets,
// uniforms, etc. Distinct from the digital `Material` teachers upload for
// their groups.
model RecursoMaterial {
  id                  String   @id @default(cuid())
  nombre              String
  campusId            String
  cantidadDisponible  Int      @default(0)
  precioUnitarioCents Int?
  // Below this quantity (and at 0), a sale through the POS notifies ADMIN
  // and Caja at that campus that it needs restocking — confirmed with the
  // user 2026-09-09 ("haga notificaciones cuando haya falta comprar").
  stockMinimo         Int      @default(5)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campus Campus         @relation(fields: [campusId], references: [id])
  ventas CashMovement[]
}

enum CashMovementType {
  ENTRADA
  SALIDA
}

enum CashRegisterSessionStatus {
  ABIERTA
  CERRADA
}

// One "día de caja" per campus — confirmed with the user 2026-09-09: "la
// caja se debe poder abrir con cierta cantidad de efectivo teórico...
// tener entradas y salidas diarias y poder hacer corte de caja y cerrar
// la caja hasta el día siguiente". Only one ABIERTA session per campus at
// a time (enforced in the open-session API route, not the schema — Prisma
// has no partial-unique-index DSL, same limitation noted elsewhere in
// this file for Enrollment). Every CashMovement made while a session is
// open is attached to it via `cashRegisterSessionId`, so the corte/cierre
// math is just "sum this session's movements", not a date-range guess.
model CashRegisterSession {
  id                  String                    @id @default(cuid())
  campusId            String
  openedById          String
  openedAt            DateTime                  @default(now())
  openingCents        Int
  closedById          String?
  closedAt            DateTime?
  // What Caja physically counted at cierre — compared against the
  // theoretical total (openingCents + entradas − salidas) to surface a
  // sobrante/faltante, but never auto-corrected: the counted number is
  // the one that's saved, and the difference is just displayed.
  closingCountedCents Int?
  status              CashRegisterSessionStatus @default(ABIERTA)

  campus    Campus         @relation(fields: [campusId], references: [id])
  openedBy  User           @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  closedBy  User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  movements CashMovement[]

  @@index([campusId, status])
}

// A simple cash ledger — Caja logs money in/out here. `invoiceId` is set
// automatically when the movement is "marcar como pagada" on an invoice
// (see reviewGroupChangeRequest-style shared function pattern used
// elsewhere); a manual entry (petty cash, an unexpected expense) has
// neither invoiceId nor recursoMaterialId. `recursoMaterialId`/`cantidad`
// are set when the movement came from a POS sale (see
// /api/admin/caja/pos/sale) — kept on this same ledger row rather than a
// separate "Sale" model so Movimientos de Caja stays the one place that
// shows everything that happened to the drawer.
model CashMovement {
  id                    String               @id @default(cuid())
  campusId              String
  tipo                  CashMovementType
  concepto              String
  montoCents            Int
  invoiceId             String?
  recursoMaterialId     String?
  cantidad              Int?
  cashRegisterSessionId String?
  createdById           String
  createdAt             DateTime             @default(now())

  campus              Campus               @relation(fields: [campusId], references: [id])
  invoice             Invoice?             @relation(fields: [invoiceId], references: [id])
  recursoMaterial     RecursoMaterial?     @relation(fields: [recursoMaterialId], references: [id])
  cashRegisterSession CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])
  createdBy           User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model ParentStudent {
  id           String  @id @default(cuid())
  parentUserId String
  studentId    String
  parent       User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
}

model Level {
  id   String @id @default(cuid())
  code String @unique
  name String

  groups Group[]
  cursos Curso[]
}

enum GroupStatus {
  ABIERTO
  EN_CURSO
  CONCLUIDO
  CANCELADO
}

model Group {
  id           String      @id @default(cuid())
  campusId     String
  levelId      String
  // Nullable during rollout: existing groups predate the Curso catalog.
  // New groups created from Control Escolar should always set this.
  cursoId      String?
  teacherId    String
  name         String
  codigoGrupo  String?     @unique
  createdAt    DateTime    @default(now())
  cupoMaximo   Int         @default(20)
  fechaInicio  DateTime?
  fechaFin     DateTime?
  estatusGrupo GroupStatus @default(ABIERTO)

  campus        Campus         @relation(fields: [campusId], references: [id])
  level         Level          @relation(fields: [levelId], references: [id])
  curso         Curso?         @relation(fields: [cursoId], references: [id])
  teacher       User           @relation("GroupTeacher", fields: [teacherId], references: [id])
  enrollments   Enrollment[]
  incidents     Incident[]
  scheduleSlots ScheduleSlot[]
  materials     Material[]

  changeRequestsFrom GroupChangeRequest[] @relation("CurrentGroup")
  changeRequestsTo   GroupChangeRequest[] @relation("RequestedGroup")
}

enum StudentCategory {
  NINOS
  ADOLESCENTES
  ADULTOS
}

// The "producto" a group actually teaches — distinct from Level (the CEFR
// A1-C2 classification used publicly on the marketing site). A Curso like
// "PET" or "FCEI" is a certification-prep track that doesn't map 1:1 to a
// single CEFR level; "1 A" is a regular kids-track course. Level stays
// untouched (it's load-bearing for the public landing/programas pages) —
// this is an additional layer on top, same pattern as StaffPosition on Role.
model Curso {
  id              String          @id @default(cuid())
  nombre          String
  categoria       StudentCategory
  esCertificacion Boolean         @default(false)
  levelId         String?
  createdAt       DateTime        @default(now())

  level  Level?  @relation(fields: [levelId], references: [id])
  groups Group[]
}

// NOTE: the database also has a partial unique index enforcing "at most one
// active (completedAt IS NULL) enrollment per student", created via raw SQL
// in migration 20260827105803_enrollment_one_active_per_student because
// Prisma's schema DSL has no WHERE-predicate syntax for @@unique/@@index.
// This index has no representation here, so `prisma migrate dev` will not
// detect drift from it — do not let a future migration silently drop it.
model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  groupId     String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group             Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
  grades            Grade[]
  blockEvaluations  BlockEvaluation[]
}

model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  token     String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LeadStatus {
  NEW
  CONTACTED
  PLACEMENT_SCHEDULED
  ENROLLED
  LOST
}

enum LeadSource {
  WEB
  REDES_SOCIALES
  REFERIDO
  VISITA_PRESENCIAL
  OTRO
  PRESENCIAL_RECEPCION
  VOLANTEO
}

enum InterestType {
  CURSO_REGULAR
  TALLER_CONVERSACION
  CERTIFICACION
}

model Lead {
  id               String        @id @default(cuid())
  name             String
  email            String
  phone            String?
  message          String?
  campusId         String?
  status           LeadStatus    @default(NEW)
  source           LeadSource    @default(OTRO)
  createdAt        DateTime      @default(now())
  dateOfBirth      DateTime?
  interestType     InterestType?
  notasBitacora    String?
  asesorAsignadoId String?

  campus                Campus?                @relation(fields: [campusId], references: [id])
  asesorAsignado        User?                  @relation("LeadAdvisor", fields: [asesorAsignadoId], references: [id])
  placementAppointments PlacementAppointment[]
}

enum PlacementAppointmentStatus {
  PROGRAMADA
  REALIZADA
  CANCELADA
  NO_ASISTIO
}

// `leadId` used to be @unique (one exam ever, no reschedule possible) —
// dropped 2026-09-09 as part of the Agenda improvement: a no-show or a
// cancelled exam needs to be reschedulable, so a lead can now have more
// than one appointment across time. The app enforces "at most one
// PROGRAMADA at a time" itself (see the create route) rather than at the
// schema level, same limitation as Enrollment's partial-unique-index note
// elsewhere in this file.
model PlacementAppointment {
  id           String                     @id @default(cuid())
  leadId       String
  scheduledFor DateTime
  campusId     String
  notes        String?
  status       PlacementAppointmentStatus @default(PROGRAMADA)
  // Free-text outcome once REALIZADA — e.g. suggested level. Recording it
  // here doesn't touch Lead.status; deciding what to do next is still
  // Admisiones' own call.
  resultado    String?
  createdAt    DateTime                   @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id])
}

enum ReceptionLogType {
  LLAMADA
  INCIDENCIA
  NOTA
}

model ReceptionLogEntry {
  id          String           @id @default(cuid())
  campusId    String
  createdById String
  type        ReceptionLogType
  note        String
  createdAt   DateTime         @default(now())

  campus    Campus @relation(fields: [campusId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

enum AlumniOutreachType {
  LLAMADA
  MENSAJE
  VISITA
  OTRO
}

// Comercial's reengagement timeline for a BAJA/GRADUADO student — the
// "bitácora" the user asked for, separate from ReceptionLogEntry above
// (which is per-campus operational notes, not sales follow-up).
model AlumniOutreachLog {
  id          String             @id @default(cuid())
  studentId   String
  createdById String
  type        AlumniOutreachType
  note        String
  createdAt   DateTime           @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  enrollmentId String
  date         DateTime         @db.Date
  status       AttendanceStatus
  createdAt    DateTime         @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
}

enum IncidentStatus {
  ABIERTA
  EN_SEGUIMIENTO
  RESUELTA
}

// Case-management fields added 2026-09-09 — before this an incidencia was
// pure read-only feed (a teacher reports it, and it just sits there
// forever with no owner and no outcome). Only "full" access on the
// "incidencias" module (Calidad y Control) can change status; everyone
// else with access just reads.
model Incident {
  id           String         @id @default(cuid())
  studentId    String
  groupId      String?
  reportedById String
  description  String
  status       IncidentStatus @default(ABIERTA)
  resolucion   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group      Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  reportedBy User    @relation(fields: [reportedById], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("IncidentResolvedBy", fields: [resolvedById], references: [id])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  audience    AnnouncementAudience
  campusId    String?
  role        Role?
  sendEmail   Boolean              @default(false)
  createdById String
  createdAt   DateTime             @default(now())

  campus    Campus? @relation(fields: [campusId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model ScheduleSlot {
  id        String   @id @default(cuid())
  groupId   String
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Material {
  id           String   @id @default(cuid())
  groupId      String
  title        String
  // `url` is always "how to open it": an external link, or the internal
  // /api/.../file route when the file was uploaded from a machine (the
  // storage* fields below are set in that case). Confirmed with the user
  // 2026-09-09 that teachers must be able to upload from local disk, not
  // only paste a link.
  url          String
  description  String?
  storageKey   String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime @default(now())

  group      Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

// The school's internal "Google Drive" for teachers — distinct from
// `Material` above (which a teacher uploads FOR their own group's
// students). This is curated BY Control Escolar and organized into
// carpetas; a teacher must request and be granted access to a carpeta
// before seeing what's inside it (confirmed with the user 2026-09-09:
// folder-level granularity, Control Escolar is the only uploader).
model MaterialCarpeta {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  createdById String
  createdAt   DateTime @default(now())

  createdBy User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items     MaterialLibraryItem[]
  requests  MaterialAccessRequest[]
}

model MaterialLibraryItem {
  id           String   @id @default(cuid())
  carpetaId    String
  titulo       String
  // Same as Material.url — external link, or the internal file route when
  // uploaded from disk (storage* fields set).
  url          String
  descripcion  String?
  storageKey   String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime @default(now())

  carpeta    MaterialCarpeta @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

enum MaterialAccessStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// No unique constraint on (carpetaId, teacherId) — a RECHAZADA request can
// be followed by a fresh one later, and the history stays as an audit
// trail. Access is derived by querying for the most recent APROBADA
// request, not by a separate grant table.
model MaterialAccessRequest {
  id           String               @id @default(cuid())
  carpetaId    String
  teacherId    String
  motivo       String?
  status       MaterialAccessStatus @default(PENDIENTE)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())

  carpeta    MaterialCarpeta @relation(fields: [carpetaId], references: [id], onDelete: Cascade)
  teacher    User            @relation("MaterialAccessRequestTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("MaterialAccessRequestReviewer", fields: [reviewedById], references: [id])
}

model Grade {
  id           String   @id @default(cuid())
  enrollmentId String
  title        String
  score        Int
  maxScore     Int      @default(100)
  createdById  String
  createdAt    DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model BlockEvaluation {
  id             String   @id @default(cuid())
  enrollmentId   String
  bloqueNumero   Int
  notaListening  Decimal  @db.Decimal(4, 2)
  notaSpeaking   Decimal  @db.Decimal(4, 2)
  notaReading    Decimal  @db.Decimal(4, 2)
  notaWriting    Decimal  @db.Decimal(4, 2)
  notaGrammar    Decimal  @db.Decimal(4, 2)
  promedioBloque Decimal  @db.Decimal(4, 2)
  createdById    String
  createdAt      DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, bloqueNumero])
}

enum GroupChangeRequestType {
  BAJA
  CAMBIO_GRUPO
}

enum GroupChangeRequestStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TicketStatus {
  ABIERTO
  EN_PROCESO
  RESUELTO
}

model GroupChangeRequest {
  id               String                   @id @default(cuid())
  type             GroupChangeRequestType
  studentId        String
  currentGroupId   String
  requestedGroupId String?
  reason           String
  status           GroupChangeRequestStatus @default(PENDIENTE)
  requestedById    String
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime                 @default(now())

  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentGroup   Group   @relation("CurrentGroup", fields: [currentGroupId], references: [id])
  requestedGroup Group?  @relation("RequestedGroup", fields: [requestedGroupId], references: [id])
  requestedBy    User    @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy     User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])
}

model InterAreaTicket {
  id           String       @id @default(cuid())
  title        String
  description  String
  createdById  String
  assignedToId String?
  status       TicketStatus @default(ABIERTO)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  createdBy  User  @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo User? @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

// Public reviews submitted from the landing page. Everything starts as
// PENDING and is invisible to visitors until a staff member with access to
// the "comunicaciones" module approves it — this is the spam/abuse gate,
// not a technical one (there's no CAPTCHA; moderation IS the defense).
model Testimonial {
  id           String            @id @default(cuid())
  name         String
  role         String?
  quote        String
  status       TestimonialStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  reviewedBy User? @relation("TestimonialReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
}

// Per-área work calendar. The user's model (2026-09-09): "cada área tiene
// su universo de trabajo independiente". Each event belongs to exactly one
// área (StaffPosition) and, optionally, one campus. A staff account sees
// only its own área's events; ADMIN and DIRECCION_CAMPUS can read every
// área. This is deliberately separate from PlacementAppointment (which is
// a cross-área artifact: Comercial books it, Recepción runs it) — those
// stay where they are.
model StaffCalendarEvent {
  id          String        @id @default(cuid())
  area        StaffPosition
  campusId    String?
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  campus    Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([area, startsAt])
}
